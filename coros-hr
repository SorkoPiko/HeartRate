#!/usr/bin/env python3
"""Stream heart rate from a BLE heart rate broadcaster (COROS Pace 3) as waybar JSON.

Connects through BlueZ over D-Bus, subscribes to the standard Heart Rate
Measurement characteristic and prints one JSON line per reading. Reconnects
on its own whenever the watch drops out or stops broadcasting.
"""
import json
import os
import sys
import time

import dbus
import dbus.mainloop.glib
from gi.repository import GLib

NAME_PREFIX = os.environ.get("COROS_HR_NAME", "COROS")
HR_MEASUREMENT = "00002a37-0000-1000-8000-00805f9b34fb"
STALE_AFTER = 10  # seconds without a reading before the value is dropped
RETRY_EVERY = 5

BLUEZ = "org.bluez"
DEVICE = "org.bluez.Device1"
ADAPTER = "org.bluez.Adapter1"
CHAR = "org.bluez.GattCharacteristic1"
PROPS = "org.freedesktop.DBus.Properties"


def emit(text, cls, tooltip):
    print(json.dumps({"text": text, "class": cls, "tooltip": tooltip}), flush=True)


def caption(value):
    return f"<span color='#9a978f'>hr</span> <span font_family='JetBrainsMono Nerd Font'>{value}</span>"


def parse(data):
    # Flags bit 0: heart rate value is uint16 instead of uint8
    data = bytes(data)
    return int.from_bytes(data[1:3], "little") if data[0] & 1 else data[1]


class Connector:
    def __init__(self):
        self.bus = dbus.SystemBus()
        self.manager = dbus.Interface(self.bus.get_object(BLUEZ, "/"), "org.freedesktop.DBus.ObjectManager")
        self.device_path = None
        self.char_path = None
        self.name = None
        self.last_bpm = None
        self.last_seen = 0
        self.connecting = False
        self.bus.add_signal_receiver(
            self.on_props, dbus_interface=PROPS, signal_name="PropertiesChanged", path_keyword="path"
        )
        self.offline()

    def objects(self):
        return self.manager.GetManagedObjects()

    def adapter(self):
        for path, ifaces in self.objects().items():
            if ADAPTER in ifaces:
                return path
        return None

    def find_device(self):
        for path, ifaces in self.objects().items():
            dev = ifaces.get(DEVICE)
            if dev and str(dev.get("Name", "")).startswith(NAME_PREFIX):
                return path, dev
        return None, None

    def find_char(self):
        for path, ifaces in self.objects().items():
            ch = ifaces.get(CHAR)
            if ch and path.startswith(self.device_path) and str(ch["UUID"]).lower() == HR_MEASUREMENT:
                return path
        return None

    def offline(self, why="watch not connected"):
        self.char_path = None
        self.last_bpm = None
        emit(caption("–"), "disconnected", why)

    def tick(self):
        """Periodic housekeeping: (re)connect and expire stale readings."""
        if self.last_bpm is not None and time.monotonic() - self.last_seen > STALE_AFTER:
            self.offline("no reading for a while")
        if self.char_path is None and not self.connecting:
            self.try_connect()
        return True

    def try_connect(self):
        path, dev = self.find_device()
        if path is None:
            self.scan()
            return
        self.device_path, self.name = path, str(dev.get("Name"))
        if not dev.get("Connected"):
            self.connecting = True
            dbus.Interface(self.bus.get_object(BLUEZ, path), DEVICE).Connect(
                reply_handler=self.on_connected, error_handler=self.on_connect_error, timeout=20
            )
            return
        self.subscribe()

    def scan(self):
        adapter = self.adapter()
        if adapter is None:
            self.offline("no bluetooth adapter")
            return
        props = dbus.Interface(self.bus.get_object(BLUEZ, adapter), PROPS)
        if props.Get(ADAPTER, "Discovering"):
            return
        ad = dbus.Interface(self.bus.get_object(BLUEZ, adapter), ADAPTER)
        try:
            ad.SetDiscoveryFilter({"Transport": "le"})
            ad.StartDiscovery()
        except dbus.DBusException:
            pass

    def stop_scan(self):
        adapter = self.adapter()
        if adapter is None:
            return
        try:
            dbus.Interface(self.bus.get_object(BLUEZ, adapter), ADAPTER).StopDiscovery()
        except dbus.DBusException:
            pass

    def on_connected(self):
        self.connecting = False
        self.stop_scan()
        # GATT services resolve shortly after Connect returns
        GLib.timeout_add(1500, self.subscribe)

    def on_connect_error(self, err):
        self.connecting = False
        self.offline(f"connect failed: {err.get_dbus_message()}")

    def subscribe(self):
        self.char_path = self.find_char()
        if self.char_path is None:
            return False  # tick retries once services resolve
        try:
            dbus.Interface(self.bus.get_object(BLUEZ, self.char_path), CHAR).StartNotify()
        except dbus.DBusException as err:
            if "InProgress" not in err.get_dbus_name():
                self.offline(f"subscribe failed: {err.get_dbus_message()}")
                return False
        emit(caption("…"), "waiting", f"{self.name}\nwaiting for first reading")
        return False

    def on_props(self, iface, changed, _invalidated, path=None):
        if iface == CHAR and path == self.char_path and "Value" in changed:
            self.last_bpm = parse(changed["Value"])
            self.last_seen = time.monotonic()
            emit(caption(self.last_bpm), "live", f"{self.name}\n{self.last_bpm} bpm")
        elif iface == DEVICE and path == self.device_path and changed.get("Connected") is False:
            self.offline()


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    conn = Connector()
    conn.tick()
    GLib.timeout_add_seconds(RETRY_EVERY, conn.tick)
    try:
        GLib.MainLoop().run()
    except KeyboardInterrupt:
        sys.exit(0)


if __name__ == "__main__":
    main()
